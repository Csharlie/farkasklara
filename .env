# Farkas Klára client — public defaults. No secrets here; local overrides go
# to .env.local (gitignored).

# Data source — only `json` is implemented for this client (no WP overlay yet).
VITE_DATA_SOURCE=json

# Form driver — `noop` in dev (console.log + fake success).
# Production driver (cf7 | mailto) is not decided yet; see README.md.
VITE_FORM_HANDLER=noop
