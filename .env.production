# Production build for https://farkaskonyveles.hu (`pnpm build`,
# `pnpm deploy:production`) — public, no secrets. `vite build` runs in
# production mode by default, so this file applies to every plain build.
# SFTP credentials live in .env.deploy.local (gitignored).
DEPLOY_BASE=/
VITE_DATA_SOURCE=json
# No live form driver yet — the PHP endpoint follows (README).
VITE_FORM_HANDLER=noop
