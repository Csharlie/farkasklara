# Copy to sp-farkasklara/.env.deploy.local (gitignored) and fill in.
# Used by `pnpm deploy:pspro` (scripts/deploy-pspro.mjs).

# pspro.hu FTP
FTP_HOST=ftp.example.hu
FTP_USER=
FTP_PASS=
# Remote folder of https://pspro.hu/farkasklara/ (e.g. /public_html/farkasklara)
FTP_DIR=/public_html/farkasklara
# TLS is required by default; set to "optional" only if the host has no FTPS.
FTP_TLS=required

# Preview login (shown to the client). Only a PBKDF2 hash reaches the server.
PREVIEW_USER=farkasklara
PREVIEW_PASSWORD=
