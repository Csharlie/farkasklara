# Copy to sp-farkasklara/.env.deploy.local (gitignored) and fill in.
# Used by `pnpm deploy:pspro` / `pnpm deploy:staging` (scripts/deploy.mjs).

# pspro.hu FTP
FTP_HOST=ftp.example.hu
FTP_USER=
FTP_PASS=
# Remote folder of https://pspro.hu/farkasklara/ (e.g. /public_html/farkasklara)
FTP_DIR=/public_html/farkasklara
# TLS is required by default; set to "optional" only if the host has no FTPS.
FTP_TLS=required

# farkaskonyveles.hu staging (SFTP, cPanel) — `pnpm deploy:staging`
STAGING_SFTP_HOST=cpanelXX.example.com
STAGING_SFTP_PORT=22
STAGING_SFTP_USER=
STAGING_SFTP_PASS=
STAGING_SFTP_DIR=/home/<user>/public_html
# Pinned SSH host key, SHA-256 base64 (ssh-keyscan HOST | ssh-keygen -lf -; the key libssh2 negotiates, usually RSA)
STAGING_SFTP_HOSTKEY=

# Preview login (shown to the client). Only a PBKDF2 hash reaches the server.
PREVIEW_USER=farkasklara
PREVIEW_PASSWORD=
