# Farkas Klára — /assets (deploy/production/assets.htaccess → assets/.htaccess).
# Build files carry a content hash in their name (index-AbC123.js), so a new
# deploy always uses new names: browsers may keep these for a year unchecked.
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
